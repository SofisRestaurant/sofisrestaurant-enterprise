# =============================================================================
# public/_headers — Sofi's Restaurant
# =============================================================================
# Reference file for Cloudflare Pages or Netlify hosting.
# On Vercel, headers are controlled by vercel.json — this file is NOT used.
# Keep in sync manually if you switch hosting providers.
# =============================================================================

# ── Global security headers (all responses) ─────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-DNS-Prefetch-Control: on
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# ── HTML shell — always revalidate ──────────────────────────────────────────
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# ── Vite hashed assets — immutable forever ──────────────────────────────────
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── Fonts — immutable, CORS-safe ────────────────────────────────────────────
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# ── Favicon / app icons ─────────────────────────────────────────────────────
/favicon*
  Cache-Control: public, max-age=604800

/apple-touch-icon*
  Cache-Control: public, max-age=604800

# ── SEO / manifest ──────────────────────────────────────────────────────────
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Cache-Control: public, max-age=86400

# ── Admin routes — no caching ───────────────────────────────────────────────
/admin/*
  Cache-Control: no-store
